# ============================================================
#  Autotabber — variabili d'ambiente (ESEMPIO, nessun segreto)
#  Copia in `.env` (mai committare!) oppure inserisci i valori
#  direttamente nelle variabili dello stack Portainer.
# ============================================================

# Porta web esposta dallo stack
WEB_PORT=8088

# --- Modal (GPU opzionale per Demucs + trascrizione) ---
# 1 = usa Modal quando le chiavi sono presenti, 0 = solo CPU locale
MODAL_ENABLED=0
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP=autotabber
MODAL_FN=transcribe

# --- Pipeline ---
# Separazione stems con Demucs (1 = attivo)
DEMUCS_ENABLED=1
DEMUCS_MODEL=htdemucs_6s
# Durata massima video accettata (secondi)
YT_MAX_DURATION_SEC=900
# Conserva i wav intermedi (debug) 1/0
KEEP_AUDIO=0
# Aggiorna yt-dlp all'avvio del worker (utile quando YouTube cambia qualcosa)
YT_DLP_UPDATE=0

# --- Anti-bot YouTube (worker) ---
# File cookies Netscape esportato dal browser (es. /data/cookies.txt
# caricato nel volume app-data). Necessario da IP datacenter/VPS.
YT_COOKIES_FILE=
# Client alternativo yt-dlp che a volte aggira il bot-check: tv_simply, android_vr...
YT_PLAYER_CLIENT=
# Proxy HTTP/SOCKS per scaricare con IP non-datacenter (es. socks5://user:pass@host:1080)
YT_PROXY=
