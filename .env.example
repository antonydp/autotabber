# Copy this file to `.env` and fill in your Modal credentials.
# NEVER commit the real .env file (it is gitignored).
# Get them with: modal token new

MODAL_TOKEN_ID=token-id-here
MODAL_TOKEN_SECRET=token-secret-here

# Optional settings
# AUTOTABBER_MAX_DURATION=600      # max seconds of audio to process
# AUTOTABBER_DATA_DIR=/data        # where artifacts are stored
# AUTOTABBER_AUTO_DEPLOY=1         # auto-run `modal deploy` on first use
# AUTOTABBER_GPU=A10G              # GPU type (baked at modal deploy time)
