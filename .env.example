# ============================================================
#  Autotabber — variabili d'ambiente (ESEMPIO, nessun segreto)
#  Copia in `.env` (mai committare!) oppure inserisci i valori
#  direttamente nelle variabili dello stack Portainer.
# ============================================================

# Porta web esposta dallo stack
WEB_PORT=8088

# --- Modal (GPU opzionale per Demucs + trascrizione) ---
# 1 = usa Modal quando le chiavi sono presenti, 0 = solo CPU locale
MODAL_ENABLED=0
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP=autotabber
MODAL_FN=transcribe

# --- Pipeline ---
# Separazione stems con Demucs (1 = attivo)
DEMUCS_ENABLED=1
DEMUCS_MODEL=htdemucs_6s
# Durata massima brano accettata (secondi)
MAX_DURATION_SEC=900
# Conserva i wav intermedi (debug) 1/0
KEEP_AUDIO=0

# --- Download (worker) ---
# Il download passa da istanze Cobalt comunitarie: il server non parla
# mai con YouTube diretto. Lascia vuoto per usare la lista pubblica
# dinamica (instances.cobalt.best), oppure indica le TUE istanze
# preferite/self-hosted separate da virgola:
COBALT_API_URLS=
# Tetto massimo dimensione file scaricato (MB)
DOWNLOAD_MAX_MB=300
